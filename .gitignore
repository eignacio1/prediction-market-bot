# ============================================================
# Prediction Market Bot — .gitignore
# CRITICAL: Never commit secrets, credentials, or live data
# NFR-05: Zero hardcoded secrets — violations are CRITICAL
# ============================================================

# --- SECRETS AND CREDENTIALS (NEVER COMMIT) ---
.env
.env.*
!.env.example
*.key
*.pem
secrets/
vault/
credentials/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
# lib/ above is meant for venv artifacts at repo root; it unintentionally also
# matches scripts/lib/ (a real, tracked source dir, T-355) since gitignore
# patterns without a leading slash match at any depth. Un-ignore it explicitly.
!scripts/lib/
!scripts/lib/**
# Re-ignore bytecode caches the line above un-ignores (trips the stop hook otherwise).
__pycache__/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
.venv/
.venv311/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- arb/ is REFERENCE ONLY (CLAUDE.md hard rule 1; ADR-0002) ---
# Never version-controlled until APR-0010 is signed.
arb/

# --- Local team-stats cache artifacts (regenerable; canonical copies in logs/) ---
team_stats_cache_*.json
~$*.docx

# --- Testing ---
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
htmlcov/
.tox/
.nox/

# --- Type checking ---
.mypy_cache/
.dmypy.json
dmypy.json

# --- IDEs ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# --- Data files (NEVER COMMIT RAW DATA — use snapshots) ---
# Raw data files are registered in DATA_SNAPSHOTS_INDEX.md
# and referenced by hash, not committed to VCS
data/raw/
data/live/
*.xlsx
*.parquet
*.jsonl
!tests/fixtures/*.csv
!tests/fixtures/*.json

# --- Game-log CSVs excluded (large; registered as snapshots) ---
exp_output/**/*.csv

# --- GG-073: MLB live-pipeline cache dir (regenerable runtime cache, not an
# EXP-NNN registered result) -- was untracked-but-uncovered, dirtying the VPS
# tree and failing every deploy.yml run since 2026-06-24.
exp_output/MLB/

# --- GG-158: forward price archive local backup (rsync'd from VPS by
# governance_scan.sh, same local-disk-only treatment as logs/'s VPS cache
# files). Grows tens of MB/day per family across a season -- never commit.
exp_output/PRICE_ARCHIVE/

# --- GG-073: pipeline-generated data contract state (row-count baselines for
# cardinality drift detection). Rewritten by every PIPE-05/PIPE-06pre run --
# tracking it in git reproduces the exact paper_portfolio.json/T-171 problem.
data/data_contracts_state.json

# --- GG-102: live-regenerated experiment results, not one-time snapshots.
# band_monitor_results.json is rewritten by the weekly VPS cron
# (run_band_monitor.py --ci, Mondays); the two EXP-*-MLB-01 results files are
# rewritten by ad-hoc reruns. Being git-tracked meant every VPS-side write
# dirtied the tree and blocked deploy.yml's guard (same T-171/paper_portfolio
# shape). Every other exp_output/**/*_results.json file is a one-time,
# non-regenerated snapshot and stays tracked as an audit trail — do not widen
# this pattern without confirming the target file is actually live-rewritten.
exp_output/EXP-ARITH-MLB-01/EXP-ARITH-MLB-01_results.json
exp_output/EXP-FLOW-MLB-01/EXP-FLOW-MLB-01_results.json
exp_output/T255-BAND-MONITOR/band_monitor_results.json

# --- GG-117: band_monitor_summary.json is band_monitor_results.json's sibling
# aggregate rollup, rewritten in place by the same weekly cron run — it was
# missed when GG-102 gitignored its sibling above, so every cron run dirtied
# the VPS tree and silently blocked deploy.yml's guard (observed 2026-07-13,
# PR #18's deploy run). Untracked here for the same reason as its sibling.
exp_output/T255-BAND-MONITOR/band_monitor_summary.json

# --- Qualitative classification CSVs ARE committed (immutable registered snapshots) ---
# Template and QS snapshots in qualitative_data/ are version-controlled.
*.csv
!qualitative_data/**/*.csv
!tests/fixtures/*.csv

# --- Model artifacts (large files — register in ARTIFACT_REGISTRY.md) ---
models/
*.pkl
*.joblib
*.h5
*.onnx

# --- Logs (never commit audit logs — retained per DATA_RETENTION_DELETION.md) ---
logs/
*.log
audit_logs/

# --- Jupyter (exploration only — see NOTEBOOKS_POLICY.md) ---
.ipynb_checkpoints/
*.ipynb

# --- Dependency lock files are committed (exception) ---
!06_CODE_EXECUTION_REPRODUCIBILITY/DEPENDENCY_LOCKS/

# --- OS ---
Thumbs.db

# --- Claude Code local session config (never commit — machine/session-specific
# permission grants, not project content; settings.json (project-shared) stays
# tracked) ---
.claude/settings.local.json

# W69.1/GG-587: untracked turn-off override written by demo_fill_forward_report
deploy/demo_fill.override.env

# W71.2: scan-generated console copy for the main checkout
.scan_output/

# NFL event store (W73.2): raw store is rebuilt from nflverse releases; only the manifest is committed
exp_output/NFL_EVENTS/

# PAM store is a versioned, committed artifact (W75.1)
!qualitative_data/pam/**/records.jsonl

# NBA event store (W78.4): raw store is rebuilt from sportsdataverse releases; only the manifest is committed
exp_output/NBA_EVENTS/

# W80P.1 thin-market depth capture store (box only; state.json + per-day JSONL)
exp_output/KALSHI_HISTORY/thin_capture/

# W80R thin-market fetch stores (raw candles; box/laptop/cloud scratch only)
exp_output/KALSHI_HISTORY/thin/
exp_output/KALSHI_HISTORY/thin_par/

# Visual Dashboard local builds (the box serves it live at /visual)
exp_output/VISUAL_DASHBOARD/

# W83.3 NHL event store (raw cache + parquet; manifest is committed)
exp_output/NHL_EVENTS/

# W90.1: Kalshi history cache for NBA/NHL/NFL (raw pages, markets, candles); manifests are committed from 12_EXPLORATORY/market_history/manifests/
exp_output/KALSHI_HISTORY/w89_7/

# W95.2 frozen-evidence check: box-local derived caches
12_EXPLORATORY/frozen_evidence_check/_cache/
12_EXPLORATORY/frozen_evidence_check/_subset/
