<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.predictionmarket.evidence-pull</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string><string>__REPO__/scripts/ops/evidence_pull.sh</string>
  </array>
  <!-- Sunday 03:00 local. launchd runs a missed StartCalendarInterval job when the Mac wakes. -->
  <key>StartCalendarInterval</key><dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__HOME__/PredictionMarketEvidence/_manifests/launchd.log</string>
  <key>StandardErrorPath</key><string>__HOME__/PredictionMarketEvidence/_manifests/launchd.log</string>
  <key>ProcessType</key><string>Background</string>
</dict></plist>
