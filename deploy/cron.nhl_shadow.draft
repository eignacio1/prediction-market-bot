# T3 (15-60 min): every 10 min 17:00-23:50 and 00:00-02:50:
# */10 17-23 * * * cd /opt/prediction-market-bot && python3 scripts/nhl_shadow_eval.py --band T3 --run-id T3-$(date -u +\%Y\%m\%dT\%H\%M) >> logs/nhl_shadow_cron.log 2>&1
