# Refresh the NHL schedule/boxscores (read-only), daily 09:00:
# 0 9 * * *   cd /opt/prediction-market-bot && python3 scripts/nhl_backfill.py --seasons 2026 --refresh-schedule >> logs/nhl_shadow_cron.log 2>&1
