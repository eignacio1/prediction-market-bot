[Unit]
Description=Prediction Market Bot — MLB T4 Live In-Play (PIPE-07 MLB)
After=network.target
Documentation=https://github.com/eignacio1/prediction-market-bot

[Service]
Type=simple
User=root
WorkingDirectory=/opt/prediction-market-bot
EnvironmentFile=/opt/prediction-market-bot/.env
# ADR-0072 / W66.2 forward-test switches (repo-mirrored; '-' = optional so deleting the file is a clean OFF)
EnvironmentFile=-/opt/prediction-market-bot/deploy/demo_fill.env
Environment=BOT_ENV=paper
Environment=BOT_C4_ACTIVE=true
Environment=PYTHONPATH=/opt/prediction-market-bot/src
# T-209 (2026-07-01): best-effort cleanup of any run_t4_mlb_live.py process not
# owned by this unit before starting — e.g. a stray cron-fired copy from a
# since-decommissioned trigger (root cause: PIPE-08 kept re-arming a legacy cron
# line for 3+ days after the systemd migration — see GOVERNANCE_GAP_LOG.md T-209 /
# run_schedule_validator_mlb.py fix), or a manual/screen invocation. Leading '-'
# swallows pkill's exit 1 (no match).
#
# T-216 (2026-07-02, GG-062): this pkill is NOT the safety net — it is
# pattern-match-and-hope, and GG-062 proved it can race (a second instance can
# start and register before this pkill's target has fully deregistered,
# leaving both alive). The actual safety net is now inside
# run_t4_mlb_live.py:acquire_singleton_lock() — an atomic flock the process
# takes before touching any shared state. If this pkill ever fails to clear a
# stray process, the new process's flock acquisition will still correctly
# refuse to start a second concurrent evaluation loop and exit(1); systemd's
# Restart=on-failure (60s cooldown, below) will keep retrying until the lock
# is free. Kept only as a fast-path cleanup, not required for correctness.
ExecStartPre=-/usr/bin/pkill -f run_t4_mlb_live.py
ExecStartPre=/bin/sleep 2
ExecStart=/opt/prediction-market-bot/venv/bin/python \
    src/prediction_market_bot/run_t4_mlb_live.py
# Restart on crash (non-zero exit). 60s cooldown prevents tight crash loops.
Restart=on-failure
RestartSec=60
# Do NOT restart when deliberately stopped via systemctl stop (SIGTERM = exit 143).
RestartPreventExitStatus=143
StandardOutput=append:/opt/prediction-market-bot/logs/t4_mlb_live_cron.log
StandardError=append:/opt/prediction-market-bot/logs/t4_mlb_live_cron.log
SyslogIdentifier=t4-mlb

# Security hardening (T-353, GG-093 residual item; partial parity with
# scripts/pmbot-web-dashboard.service, deliberately not full parity).
#
# Adopted, verified safe:
# - PrivateTmp/NoNewPrivileges: this process never touches /tmp (confirmed by
#   grep of run_t4_mlb_live.py — its singleton lock lives under _LOGS_DIR, not
#   /tmp: SINGLETON_LOCK_PATH = _LOGS_DIR / "t4_mlb_live.lock") and never
#   needs setuid/setgid, so both are pure hardening with zero functional risk.
# - MemoryMax=512M / CPUQuota=50%: sized from live VPS telemetry at deploy
#   time (2026-07-21/22): steady-state RSS 95-109M peak over a 2-day run,
#   average CPU ~2.5% of the box's single core. 512M/50% leaves ~5x memory
#   headroom and ~20x CPU headroom over observed normal operation while still
#   bounding a runaway loop from starving the whole (single-core, ~1GB RAM)
#   VPS — the same rationale the dashboard unit already applies, re-derived
#   against this service's own (higher, live-API-polling) baseline rather
#   than copying the dashboard's 128M/10% figures verbatim.
#
# Deliberately NOT adopted (would break function, not evaluated as safe):
# - ReadOnlyPaths: the dashboard's directive marks its own logs/ dir
#   read-only because it only ever reads logs. This service WRITES to
#   logs/ continuously (paper_portfolio_mlb_t4.json, audit_mlb_t4.jsonl,
#   audit_mlb_t4_edge_decisions.jsonl, the singleton lock file) — applying
#   the same directive here would halt live paper trading on first write.
# - ProtectSystem=strict + ReadWritePaths exception: would give equivalent
#   defense-in-depth without blocking logs/ writes, but is a materially
#   larger change (whole-filesystem read-only sandboxing) than this task's
#   scope, unverified against every path this process or its dependencies
#   (venv, ESPN/MLB Stats API TLS cert lookups, etc.) may touch at runtime.
#   Flagged as a candidate for a dedicated follow-up with its own staged
#   test, not force-implemented against the only live trading pipeline.
PrivateTmp=true
NoNewPrivileges=true
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
