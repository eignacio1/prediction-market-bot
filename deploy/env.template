# ENV-02 — Paper Trading Environment Template
# Copy to .env and fill in values. chmod 600 .env after filling.
# NEVER commit this file or any file containing real VENUE_API_KEY.
# Per NFR-05: zero hardcoded secrets.

# Environment identifier (must be 'paper' in ENV-02)
BOT_ENV=paper

# Audit log directory (C6 output)
LOG_DIR=/opt/prediction-market-bot/logs

# Kalshi read-only API key (ACC-0002 provisioned 2026-05-28)
# Market data only — no order submission credentials in ENV-02
VENUE_API_KEY=REPLACE_WITH_YOUR_KALSHI_READ_ONLY_KEY

# Venue identifier (per ADR-0003 — Kalshi primary)
VENUE_ID=kalshi

# Audit log path (C6 — override if needed)
BOT_AUDIT_LOG_PATH=/opt/prediction-market-bot/logs/audit.jsonl

# DO NOT SET: BOT_C4_ACTIVE — must be absent in ENV-02
# Setting BOT_C4_ACTIVE=true would enable risk engine; prohibited until G6.
