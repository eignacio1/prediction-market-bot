# ADR-0072 forward test (W66.2) -- ACCEPTED, operator 2026-10-10 19:13 PT. DEMO venue only.
# Repo-mirrored switch config. Loaded by: deploy/t4-mlb.service (EnvironmentFile) and the T1 MLB demo
# order cron line (deploy/cron_demo_fill.conf). TURN OFF = delete this file's two switch lines (or the file)
# and restart; ADR-0072 turn-off conditions apply. Registered parameters may NOT change (new line needed).
# Plain KEY=VALUE only (read by systemd and by `export $(grep -v '^#' f | xargs)`).
DEMO_FILL_PLACEMENT_RULE=book_anchor_cancel
SHADOW_FLAT_STAKE=on
DEMO_FILL_CANCEL_AFTER_S=60
DEMO_FILL_MAX_MID_GAP=0.05
DEMO_FILL_ASSIGN_SHARE=0.5
DEMO_FILL_SEED=w64-2
