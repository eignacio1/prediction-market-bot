# ADR-0072 forward test (W66.2) -- ACCEPTED, operator 2026-10-10 19:13 PT. DEMO venue only.
# Repo-mirrored switch config. Loaded by: deploy/t4-mlb.service (EnvironmentFile) and the T1 MLB demo
# order cron line (deploy/cron_demo_fill.conf). TURN OFF = delete this file's two switch lines (or the file)
# and restart; ADR-0072 turn-off conditions apply. Registered parameters may NOT change (new line needed).
# Plain KEY=VALUE only (read by systemd and by `export $(grep -v '^#' f | xargs)`).
DEMO_FILL_PLACEMENT_RULE=book_anchor_cancel
SHADOW_FLAT_STAKE=on
DEMO_FILL_CANCEL_AFTER_S=60
DEMO_FILL_MAX_MID_GAP=0.05
DEMO_FILL_ASSIGN_SHARE=0.5
DEMO_FILL_SEED=w64-2
# W112.3 / B-083: the router arm drives the demo orders. Operator 2026-11-11 16:51 PT ("yes I approve"); addendum 03_DECISIONS/ADR-0072_ADDENDUM_2026-11-12_arm-orders.md. DEMO only, flat stakes, kelly 0. TURN OFF = delete this line.
ARM_ORDERS=on
# W116.2 / B-095: two switches, both OFF by absence (the code treats a missing key as off). Turning either on is a NEW line,
# added only after the operator approves it in ACTIVE_QUEUE "Needs your decision" (ADR-0072 addendum proposal, W116.2):
#   ARM_BOOK_CAPS=raised        -> demo arm book caps 25 / 2500 / 1500 instead of the base 5 / 50 / 25
#   ARM_PLACEMENT_POLICY=on     -> per-arm / leaf placement from the frozen config/placement_policy.json (else rest_touch)
# W117.1 / B-095: raised demo arm book caps. Operator APPROVED 2026-11-17 (ACTIVE_QUEUE "Needs your decision", W116.2 approvals; #508 merged). DEMO only, kelly 0. TURN OFF = delete this line.
ARM_BOOK_CAPS=raised
