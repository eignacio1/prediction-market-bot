# NHL pregame SHADOW-evaluation cron (T-607 / EXP-036) -- INSTALLED per operator authorization
# (04_EXECUTION/ACTIVE_QUEUE.md "Needs your decision", 2026-10-02). Evaluate-and-log only:
# read-only Kalshi/NHL reads <=1 req/s, appends to data/shadow/nhl/ only. No .env, no order path
# (tests/test_nhl_shadow_safety.py). Times UTC. Uses $PYTHON/$PROJ/$PYTHONPATH from the crontab header.
0 9 * * *    cd $PROJ && $PYTHON scripts/nhl_backfill.py --seasons 2026 --refresh-schedule >> logs/nhl_shadow_cron.log 2>&1
0 14 * * * ( flock -n 9 || { printf '{"ts":"\%s","runner":"nhl_staked_t1","event":"SKIP_LOCKED","reason":"previous run still holding /tmp/nhl_staked_t1.lock"}\n' "$(date -u +\%FT\%TZ)" | tee -a /opt/prediction-market-bot/logs/t3_skips.jsonl > /dev/null; exit 0; }; cd $PROJ && export $(grep -v '^#' .env | xargs) && export $(grep -sv '^#' deploy/demo_fill.env | xargs) && BOT_ENV=paper $PYTHON scripts/run_nhl_shadow_staked.py --band T1 --run-id T1-$(date -u +\%Y\%m\%dT\%H) >> logs/nhl_shadow_cron.log 2>&1 ) 9>/tmp/nhl_staked_t1.lock
4,34 15-23 * * * ( flock -n 9 || { printf '{"ts":"\%s","runner":"nhl_staked_t2","event":"SKIP_LOCKED","reason":"previous run still holding /tmp/nhl_staked_t2.lock"}\n' "$(date -u +\%FT\%TZ)" | tee -a /opt/prediction-market-bot/logs/t3_skips.jsonl > /dev/null; exit 0; }; cd $PROJ && export $(grep -v '^#' .env | xargs) && export $(grep -sv '^#' deploy/demo_fill.env | xargs) && BOT_ENV=paper $PYTHON scripts/run_nhl_shadow_staked.py --band T2 --run-id T2-$(date -u +\%Y\%m\%dT\%H\%M) >> logs/nhl_shadow_cron.log 2>&1 ) 9>/tmp/nhl_staked_t2.lock
4,34 0-1 * * * ( flock -n 9 || { printf '{"ts":"\%s","runner":"nhl_staked_t2","event":"SKIP_LOCKED","reason":"previous run still holding /tmp/nhl_staked_t2.lock"}\n' "$(date -u +\%FT\%TZ)" | tee -a /opt/prediction-market-bot/logs/t3_skips.jsonl > /dev/null; exit 0; }; cd $PROJ && export $(grep -v '^#' .env | xargs) && export $(grep -sv '^#' deploy/demo_fill.env | xargs) && BOT_ENV=paper $PYTHON scripts/run_nhl_shadow_staked.py --band T2 --run-id T2-$(date -u +\%Y\%m\%dT\%H\%M) >> logs/nhl_shadow_cron.log 2>&1 ) 9>/tmp/nhl_staked_t2.lock
6,16,26,36,46,56 17-23 * * * ( flock -n 9 || { printf '{"ts":"\%s","runner":"nhl_staked_t3","event":"SKIP_LOCKED","reason":"previous run still holding /tmp/nhl_staked_t3.lock"}\n' "$(date -u +\%FT\%TZ)" | tee -a /opt/prediction-market-bot/logs/t3_skips.jsonl > /dev/null; exit 0; }; cd $PROJ && export $(grep -v '^#' .env | xargs) && export $(grep -sv '^#' deploy/demo_fill.env | xargs) && BOT_ENV=paper $PYTHON scripts/run_nhl_shadow_staked.py --band T3 --run-id T3-$(date -u +\%Y\%m\%dT\%H\%M) >> logs/nhl_shadow_cron.log 2>&1 ) 9>/tmp/nhl_staked_t3.lock
6,16,26,36,46,56 0-2 * * * ( flock -n 9 || { printf '{"ts":"\%s","runner":"nhl_staked_t3","event":"SKIP_LOCKED","reason":"previous run still holding /tmp/nhl_staked_t3.lock"}\n' "$(date -u +\%FT\%TZ)" | tee -a /opt/prediction-market-bot/logs/t3_skips.jsonl > /dev/null; exit 0; }; cd $PROJ && export $(grep -v '^#' .env | xargs) && export $(grep -sv '^#' deploy/demo_fill.env | xargs) && BOT_ENV=paper $PYTHON scripts/run_nhl_shadow_staked.py --band T3 --run-id T3-$(date -u +\%Y\%m\%dT\%H\%M) >> logs/nhl_shadow_cron.log 2>&1 ) 9>/tmp/nhl_staked_t3.lock
