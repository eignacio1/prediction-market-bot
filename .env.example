# ==============================================================
# .env.example — Prediction Market Bot
# ==============================================================
# COPY THIS FILE to .env and fill in values for your environment.
# NEVER commit .env to version control (it is in .gitignore).
# See SECRETS_HANDLING.md for the full protocol.
# ==============================================================

# ----- Environment identifier (REQUIRED) -----
# Phase labels (ENV-01/02/03) are documentation names only, never the literal
# value — the value itself must be one of: paper, live (case-insensitive).
# ENV-01 (research, no Kalshi calls) -> BOT_ENV unset or any non-live value
# ENV-02 (paper trading)             -> BOT_ENV=paper
# ENV-03 (live capital)              -> BOT_ENV=live
# This controls whether live credentials are loaded and which Kalshi base URL
# authenticated calls use (kalshi_client.py::_kalshi_base_url(), GG-152).
BOT_ENV=paper

# ----- Logging -----
LOG_LEVEL=INFO
LOG_DIR=logs/

# ----- Data paths -----
# Path to DATA_SNAPSHOTS directory (no trailing slash)
SNAPSHOT_DIR=data/snapshots

# ----- Venue API (ENV-02 and ENV-03 only — NOT set in ENV-01) -----
# Venue: TBD at ADR-0003 (Kalshi / Polymarket / other)
# VENUE_API_KEY=          # NEVER hardcode — set in .env or vault
# VENUE_API_SECRET=       # NEVER hardcode — set in .env or vault
# VENUE_BASE_URL=

# ----- Model settings (Phase 3+) -----
# MODEL_VERSION=          # e.g., MODEL-001
# FEATURE_STORE_PATH=

# ----- Kill switch settings (Phase 5+) -----
# KILL_SWITCH_DAILY_LOSS_LIMIT=    # from RISK_APPETITE_CONSTRAINTS.md (TBD at G4)
# KILL_SWITCH_SESSION_LOSS_LIMIT=  # from RISK_APPETITE_CONSTRAINTS.md (TBD at G4)
# KILL_SWITCH_MAX_POSITION_SIZE=   # from RISK_APPETITE_CONSTRAINTS.md (TBD at G4)
